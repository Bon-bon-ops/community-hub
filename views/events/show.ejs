<div class="page-header">
  <h1><%= event.title %></h1>
</div>

<p class="meta">📍 <%= event.location %> · 📅 <%= new Date(event.event_date).toLocaleDateString() %></p>

<div class="content-box">
  <p><%= event.description || 'No description provided.' %></p>
</div>

<div class="card-actions">
  <a href="/events" class="btn btn-small btn-outline">&larr; Back to Events</a>
  <% if (currentUser) { %>
    <a href="/events/<%= event.id %>/edit" class="btn btn-small">Edit</a>
    <form action="/events/<%= event.id %>?_method=DELETE" method="POST" class="inline-form">
      <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Delete this event?')">Delete</button>
    </form>
  <% } %>
</div>
